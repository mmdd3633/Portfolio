
module full_adder(input a, input b, input cin, output sum, output cout);
    wire w1, w2, w3;
    xor (w1, a, b);
    xor (sum, w1, cin);
    and (w2, a, b);
    and (w3, w1, cin);
    or  (cout, w2, w3);
endmodule


module not_8bit (
    input  [7:0] A,
    output [7:0] Y
);
    genvar i;
    generate
        for (i = 0; i < 8; i = i + 1) begin : not_loop
            not not_gate (Y[i], A[i]);
        end
    endgenerate
endmodule


module not_16bit (
    input  [15:0] A,
    output [15:0] Y
);
    genvar i;
    generate
        for (i = 0; i < 16; i = i + 1) begin : not_gate
            not (Y[i], A[i]);
        end
    endgenerate
endmodule


module adder_8bit (
    input  [7:0] A,
    input  [7:0] B,
    input        cin,
    output [7:0] sum,
    output       cout
);
    wire [7:0] c;

    full_adder fa0 (.a(A[0]), .b(B[0]), .cin(cin),     .sum(sum[0]), .cout(c[0]));
    full_adder fa1 (.a(A[1]), .b(B[1]), .cin(c[0]),    .sum(sum[1]), .cout(c[1]));
    full_adder fa2 (.a(A[2]), .b(B[2]), .cin(c[1]),    .sum(sum[2]), .cout(c[2]));
    full_adder fa3 (.a(A[3]), .b(B[3]), .cin(c[2]),    .sum(sum[3]), .cout(c[3]));
    full_adder fa4 (.a(A[4]), .b(B[4]), .cin(c[3]),    .sum(sum[4]), .cout(c[4]));
    full_adder fa5 (.a(A[5]), .b(B[5]), .cin(c[4]),    .sum(sum[5]), .cout(c[5]));
    full_adder fa6 (.a(A[6]), .b(B[6]), .cin(c[5]),    .sum(sum[6]), .cout(c[6]));
    full_adder fa7 (.a(A[7]), .b(B[7]), .cin(c[6]),    .sum(sum[7]), .cout(cout));
endmodule


module adder_16bit(input [15:0] A, input [15:0] B, input cin, output [15:0] sum, output cout);
    wire [15:0] carry;
    genvar i;
    generate
        for (i = 0; i < 16; i = i + 1) begin: full_adder_chain
            if (i == 0)
                full_adder fa (A[i], B[i], cin, sum[i], carry[i]);
            else
                full_adder fa (A[i], B[i], carry[i-1], sum[i], carry[i]);
        end
    endgenerate
    assign cout = carry[15];
endmodule


module carry_adder_32 (
    input  [31:0] A,
    input  [31:0] B,
    output [31:0] sum,
    output        cout
);
    wire [31:0] carry;

    assign carry[0] = 1'b0;

    genvar i;
    generate
        for (i = 0; i < 32; i = i + 1) begin : gen_fa
            full_adder fa (
                .a(A[i]),
                .b(B[i]),
                .cin(carry[i]),
                .sum(sum[i]),
                .cout(carry[i+1])
            );
        end
    endgenerate

    assign cout = carry[32];
endmodule


module subtractor_8bit(
    input  [7:0] A,
    input  [7:0] B,
    output [7:0] S
);
    wire [7:0] B_inv;

    // NOT ??? B? ??? ??
    not_8bit inverter (.A(B), .Y(B_inv));

    adder_8bit adder (
        .A(A),
        .B(B_inv),
        .cin(1'b1),  //
        .sum(S),
        .cout()
    );
endmodule


module subtractor_16bit (
    input  [15:0] A,
    input  [15:0] B,
    output [15:0] Y,
    output        cout    
);
    wire [15:0] B_inv;
    wire        cin;
    wire [15:0] sum;

    assign cin = 1'b1;  // 2's complement: A + (~B + 1)

    // B ?? ??
    genvar i;
    generate
        for (i = 0; i < 16; i = i + 1) begin : invert_loop
            not (B_inv[i], B[i]);
        end
    endgenerate

    // A - B = A + (~B) + 1
    adder_16bit adder (
        .A(A),
        .B(B_inv),
        .cin(cin),
        .sum(Y),
        .cout(cout)  // ?? ??? ?? ??
    );
endmodule


module sbc_8bit(
    input  [7:0] A,
    input  [7:0] B,
    input        cin,
    output [7:0] S
);
    wire [7:0] B_inv;

    // NOT ??? B? ??? ??
    not_8bit inverter (.A(B), .Y(B_inv));

    adder_8bit adder (
        .A(A),
        .B(B_inv),
        .cin(cin),
        .sum(S),
        .cout()
    );
endmodule


module sbc_16bit (
    input  [15:0] A,
    input  [15:0] B,
    input         cin,
    output [15:0] sum,
    output        cout
);
    wire [15:0] B_inv;
    wire        internal_cout;

    // B? ??? not_16bit? ?? (??? ?? ?? ?? ??)
    not_16bit inverter (.A(B), .Y(B_inv));

    // ??? carry in ??? ?? ??
    adder_16bit sbc_adder (
        .A(A),
        .B(B_inv),
        .cin(cin),
        .sum(sum),
        .cout(internal_cout)
    );

    assign cout = internal_cout;

endmodule


