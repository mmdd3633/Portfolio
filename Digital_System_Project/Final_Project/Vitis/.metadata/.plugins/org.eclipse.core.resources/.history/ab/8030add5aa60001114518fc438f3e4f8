#include <stdio.h>
#include "xparameters.h"
#include "xil_printf.h"
#include "sleep.h"
#include "xiic.h"
#include "xiic_l.h"
#include "xgpio.h"
#include "xstatus.h" // [수정됨] XST_SUCCESS 및 XST_FAILURE 상태 코드를 사용하기 위한 필수 헤더 추가

// ==============================================================================
// 1. 하드웨어 주소 및 매크로 정의
// ==============================================================================
#define IIC_BASE_ADDR       XPAR_IIC_0_BASEADDR
#define GPIO_7SEG_ID        XPAR_AXI_GPIO_0_DEVICE_ID
#define GPIO_LED_BTN_ID     XPAR_AXI_GPIO_1_DEVICE_ID

#define LSM9DS1_AG_ADDR_1   0x6B
#define LSM9DS1_AG_ADDR_2   0x6A
#define REG_WHO_AM_I_XG     0x0F
#define REG_CTRL_REG6_XL    0x20
#define REG_OUT_X_L_XL      0x28

XGpio Gpio_7Seg;
XGpio Gpio_LedBtn;

// ==============================================================================
// 2. I2C 사용자 정의 함수
// ==============================================================================
int I2C_WriteReg(u8 SlaveAddr, u8 RegAddr, u8 Data) {
    u8 write_buf[2] = {RegAddr, Data};
    return XIic_Send(IIC_BASE_ADDR, SlaveAddr, write_buf, 2, XIIC_STOP);
}

int I2C_ReadReg(u8 SlaveAddr, u8 RegAddr, u8 *DataBuffer, unsigned ByteCount) {
    XIic_Send(IIC_BASE_ADDR, SlaveAddr, &RegAddr, 1, XIIC_REPEATED_START);
    return XIic_Recv(IIC_BASE_ADDR, SlaveAddr, DataBuffer, ByteCount, XIIC_STOP);
}

// ==============================================================================
// 3. 메인 함수
// ==============================================================================
int main()
{
    int Status; // GPIO 초기화 성공 여부를 저장할 상태 변수
    u8 Target_Addr = LSM9DS1_AG_ADDR_1;
    u8 who_am_i = 0;
    u8 rx_data[6];

    sleep(2);
    xil_printf("\n\r======================================\n\r");
    xil_printf("  Advanced Sensor System Initializing...\n\r");
    xil_printf("======================================\n\r");

    // ---------------------------------------------------------
    // [수정됨] GPIO 초기화 및 에러 검증 (Status 변수 정상 활용)
    // ---------------------------------------------------------
    Status = XGpio_Initialize(&Gpio_7Seg, GPIO_7SEG_ID);
    if (Status != XST_SUCCESS) {
        xil_printf("[ERROR] 7-Segment GPIO Initialization Failed!\n\r");
        return XST_FAILURE;
    }
    XGpio_SetDataDirection(&Gpio_7Seg, 1, 0x00000000);

    Status = XGpio_Initialize(&Gpio_LedBtn, GPIO_LED_BTN_ID);
    if (Status != XST_SUCCESS) {
        xil_printf("[ERROR] LED/BTN GPIO Initialization Failed!\n\r");
        return XST_FAILURE;
    }
    XGpio_SetDataDirection(&Gpio_LedBtn, 1, 0x00000000); // LED Output
    XGpio_SetDataDirection(&Gpio_LedBtn, 2, 0xFFFFFFFF); // BTN Input

    // ---------------------------------------------------------
    // I2C 초기화 및 센서 확인
    // ---------------------------------------------------------
    XIic_WriteReg(IIC_BASE_ADDR, XIIC_CR_REG_OFFSET, 0x00);
    XIic_WriteReg(IIC_BASE_ADDR, XIIC_CR_REG_OFFSET, XIIC_CR_TX_FIFO_RESET_MASK);
    XIic_WriteReg(IIC_BASE_ADDR, XIIC_CR_REG_OFFSET, XIIC_CR_ENABLE_DEVICE_MASK);
    usleep(50000);

    I2C_ReadReg(Target_Addr, REG_WHO_AM_I_XG, &who_am_i, 1);
    if (who_am_i != 0x68) {
        Target_Addr = LSM9DS1_AG_ADDR_2;
        I2C_ReadReg(Target_Addr, REG_WHO_AM_I_XG, &who_am_i, 1);
    }

    if (who_am_i != 0x68) {
        xil_printf("[ERROR] Sensor Not Found! Read WHO_AM_I: 0x%02X\n\r", who_am_i);
        return XST_FAILURE;
    }

    // 센서 활성화 (가속도 센서 켜기)
    I2C_WriteReg(Target_Addr, REG_CTRL_REG6_XL, 0x60);
    usleep(100000);

    // ---------------------------------------------------------
    // [시스템 상태 변수 선언]
    // ---------------------------------------------------------
    int display_mode = 0;        // 0: X, 1: Y, 2: Z
    short offset_x = 0, offset_y = 0, offset_z = 0; // 영점 조절용 오프셋
    int is_paused = 0;           // 화면 정지 플래그
    u32 prev_btn = 0;            // 이전 버튼 상태 (엣지 검출용)

    xil_printf("System Ready. Entering Data Loop...\n\r");

    while (1) {
        // 1. 데이터 읽기 및 비트 결합 (Raw 데이터)
        I2C_ReadReg(Target_Addr, REG_OUT_X_L_XL, rx_data, 6);
        short raw_x = (short)((rx_data[1] << 8) | rx_data[0]);
        short raw_y = (short)((rx_data[3] << 8) | rx_data[2]);
        short raw_z = (short)((rx_data[5] << 8) | rx_data[4]);

        // 2. 버튼 입력 엣지 검출 (누르는 순간만 동작)
        u32 curr_btn = XGpio_DiscreteRead(&Gpio_LedBtn, 2);
        u32 btn_press = curr_btn & ~prev_btn; // 이전엔 0이었는데 지금 1인 비트만 추출
        prev_btn = curr_btn;

        // 버튼 0: 모드 순환 (X -> Y -> Z)
        if (btn_press & 0x01) {
            display_mode = (display_mode + 1) % 3;
            xil_printf("\n\r>>> Mode Changed to: %d <<<\n\r", display_mode);
        }
        // 버튼 1: 기준 자세 저장 (현재 Raw 값을 오프셋으로 설정)
        if (btn_press & 0x02) {
            offset_x = raw_x;
            offset_y = raw_y;
            offset_z = raw_z;
            xil_printf("\n\r>>> Calibration Set! <<<\n\r");
        }
        // 버튼 2: 영점 초기화 (오프셋 해제)
        if (btn_press & 0x04) {
            offset_x = 0;
            offset_y = 0;
            offset_z = 0;
            xil_printf("\n\r>>> Calibration Reset! <<<\n\r");
        }
        // 버튼 3: 일시 정지 (Pause/Resume)
        if (btn_press & 0x08) {
            is_paused = !is_paused;
            xil_printf("\n\r>>> Display Paused: %d <<<\n\r", is_paused);
        }

        // 일시 정지 상태면 아래 출력 업데이트 로직을 건너뜀
        if (!is_paused) {
            // 3. 캘리브레이션(영점) 적용 데이터 계산
            short calib_x = raw_x - offset_x;
            short calib_y = raw_y - offset_y;
            short calib_z = raw_z - offset_z;

            // 4. 표시 대상 선택 및 절댓값 변환
            short target_val = 0;
            if (display_mode == 0) target_val = calib_x;
            else if (display_mode == 1) target_val = calib_y;
            else if (display_mode == 2) target_val = calib_z;

            int abs_val = target_val;
            if (abs_val < 0) abs_val = -abs_val;

            // 7-Segment 출력
            XGpio_DiscreteWrite(&Gpio_7Seg, 1, (u32)abs_val);

            // 5. LED 출력 조합 (일반 0~9 + RGB 10~15)
            u32 led_out = 0x0000;

            // (1) 일반 LED (0~9): 값의 크기에 따른 바 그래프
            int level = abs_val / 1500; // 1500 단위로 불이 하나씩 켜짐
            if (level > 10) level = 10;
            u32 bar_graph = (1 << level) - 1;
            led_out |= (bar_graph & 0x03FF);  // 하위 10비트에 적용

            // (2) RGB LED 1 (10, 11, 12): 현재 축 모드 표시 (10:Red, 11:Green, 12:Blue)
            if (display_mode == 0)      led_out |= (1 << 10); // X축 (R)
            else if (display_mode == 1) led_out |= (1 << 11); // Y축 (G)
            else if (display_mode == 2) led_out |= (1 << 12); // Z축 (B)

            // (3) RGB LED 2 (13, 14, 15): 위험 경고 (13:Red, 14:Green)
            if (abs_val > 8000) {
                led_out |= (1 << 13); // 임계값 초과 위험 (Red)
            } else {
                led_out |= (1 << 14); // 안전 상태 (Green)
            }

            // 최종 LED 제어 신호 전송
            XGpio_DiscreteWrite(&Gpio_LedBtn, 1, led_out);

            // UART 모니터링 출력
            xil_printf("Mode: %d | Calib_X: %6d, Y: %6d, Z: %6d\r", display_mode, calib_x, calib_y, calib_z);
        }

        usleep(50000); // 50ms 대기
    }

    return 0;
}
