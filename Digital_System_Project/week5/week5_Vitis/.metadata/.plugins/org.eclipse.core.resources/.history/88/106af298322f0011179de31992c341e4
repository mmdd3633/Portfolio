#include <stdio.h>
#include <stdlib.h>
#include "xparameters.h"
#include "xgpio.h"
#include "xil_printf.h"

#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define RGB_CH 1

XGpio Gpio;

int main() {
    int r_val = 0;
    u32 combined_rgb;

    // 1. GPIO 초기화
    if (XGpio_Initialize(&Gpio, GPIO_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("GPIO Initialization Failed!\r\n");
        return XST_FAILURE;
    }
    XGpio_SetDataDirection(&Gpio, RGB_CH, 0x0);

    // 2. [하드웨어 테스트] 시작하자마자 빨간색 풀 가동 (0xFF0000)
    xil_printf("--- Hardware Test: Red LED ON ---\r\n");
    XGpio_DiscreteWrite(&Gpio, RGB_CH, 0xFF0000);

    xil_printf("If the LED is NOT ON now, check your XDC pin numbers.\r\n");
    xil_printf("Enter Red Intensity (0-255): ");

    while(1) {
        // 3. 숫자 입력 받기
        if (scanf("%d", &r_val) == 1) {
            if(r_val > 255) r_val = 255;
            if(r_val < 0) r_val = 0;

            // Red 비트 위치로 정렬 (상위 8비트)
            combined_rgb = ((u32)r_val << 16);
            XGpio_DiscreteWrite(&Gpio, RGB_CH, combined_rgb);

            xil_printf(">> Applied Red: %d (Data: 0x%08X)\r\n", r_val, combined_rgb);
            xil_printf("Next Value (0-255): ");
        }

        // 버퍼 비우기 (무한루프 방지)
        getchar();
    }
    return 0;
}
