#include <stdio.h>
#include <stdlib.h>    // atoi 함수 사용을 위해 추가
#include "xparameters.h"
#include "xgpio.h"
#include "xil_printf.h"

#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define RGB_CH 1

XGpio Gpio;

int main() {
    int status;
    char input_buf[10]; // 키보드 입력을 임시로 저장할 버퍼
    int r_val = 0;
    u32 combined_rgb;

    status = XGpio_Initialize(&Gpio, GPIO_DEVICE_ID);
    if (status != XST_SUCCESS) return XST_FAILURE;
    XGpio_SetDataDirection(&Gpio, RGB_CH, 0x0);

    xil_printf("\r\n--- LD10 Red LED Control (Safe Mode) ---\r\n");

    while(1) {
        xil_printf("Input Red Brightness (0-255) and Press Enter: ");

        // 1. 입력을 문자열로 한 줄 통째로 받음 (엔터칠 때까지 대기)
        if (fgets(input_buf, sizeof(input_buf), stdin) != NULL) {

            // 2. 문자열을 정수로 변환
            r_val = atoi(input_buf);

            // 3. 값 범위 제한
            if(r_val > 255) r_val = 255;
            if(r_val < 0) r_val = 0;

            // 4. 하드웨어 비트 위치에 맞게 시프트 (Red: 23~16비트 가정)
            combined_rgb = ((u32)r_val << 16);

            XGpio_DiscreteWrite(&Gpio, RGB_CH, combined_rgb);

            xil_printf(">> Applied Red: %d (Hex: 0x%08X)\r\n\n", r_val, combined_rgb);
        }
    }
    return 0;
}
