#include <stdio.h>
#include "xparameters.h"
#include "xgpio.h"
#include "xil_printf.h"

// 1. 하드웨어 주소 확인 (Vivado Address Editor의 이름과 일치해야 함)
#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define RGB_CH 1

XGpio Gpio;

int main() {
    int r_val = 0;
    u32 combined_rgb;

    // 2. GPIO 초기화
    if (XGpio_Initialize(&Gpio, GPIO_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("GPIO Init Failed! Check your Hardware Design.\r\n");
        return XST_FAILURE;
    }

    // 3. 출력 방향 설정 (0은 출력)
    XGpio_SetDataDirection(&Gpio, RGB_CH, 0x0);

    xil_printf("\r\n=== LD10 Red LED Control Start ===\r\n");

    while(1) {
        xil_printf("Enter Red Value (0-255): ");

        // 4. 숫자 입력 받기
        if (scanf("%d", &r_val) == 1) {
            // 범위 제한 (Saturation)
            if(r_val > 255) r_val = 255;
            if(r_val < 0) r_val = 0;

            // 5. 비트 정렬 (중요!)
            // 보통 RGB 패킹은 R:[23:16], G:[15:8], B:[7:0] 순서입니다.
            // 만약 하드웨어에서 Red를 하위 8비트로 설계했다면 시프트를 지우세요.
            combined_rgb = ((u32)r_val << 16);

            // 6. 데이터 전송
            XGpio_DiscreteWrite(&Gpio, RGB_CH, combined_rgb);

            xil_printf(">> Applied Value: %d (Hex: 0x%08X)\r\n", r_val, combined_rgb);
        }

        // 입력 버퍼 비우기 (엔터 키 등 찌꺼기 제거)
        getchar();
    }
    return 0;
}
