module sbc_16bit (
    input  [15:0] A,
    input  [15:0] B,
    input         cin,
    output [15:0] sum,
    output        cout
);
    wire [15:0] B_inv;
    wire        internal_cout;

    // B? ??? not_16bit? ?? (??? ?? ?? ?? ??)
    not_16bit inverter (.A(B), .Y(B_inv));

    // ??? carry in ??? ?? ??
    adder_16bit sbc_adder (
        .A(A),
        .B(B_inv),
        .cin(cin),
        .sum(sum),
        .cout(internal_cout)
    );

    assign cout = internal_cout;

endmodule

module sbc_8bit(
    input  [7:0] A,
    input  [7:0] B,
    input        cin,
    output [7:0] S,
    output       cout 
);
    wire [7:0] B_inv;
    wire       cout_internal;  // ? ?? ??

    // NOT ??? B? ??? ??
    not_8bit inverter (.A(B), .Y(B_inv));

    adder_8bit adder (
        .A(A),
        .B(B_inv),
        .cin(cin),
        .sum(S),
        .cout(cout_internal)
    );
    
    assign cout = cout_internal;
endmodule



module subtractor_8bit (
    input  [7:0] A,
    input  [7:0] B,
    output [7:0] S
);
    wire [7:0] B_inv;

    not_8bit inverter (.A(B), .Y(B_inv));

    adder_8bit adder (
        .A(A),
        .B(B_inv),
        .cin(1'b1),
        .sum(S),
        .cout()
    );
endmodule



