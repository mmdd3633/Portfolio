#include <stdio.h>
#include "xparameters.h"
#include "xil_printf.h"
#include "sleep.h"
#include "xiic.h"
#include "xiic_l.h"
#include "xgpio.h"
#include "xstatus.h" // 안전한 빌드를 위해 상태 코드 헤더만 추가 유지합니다.

// ==============================================================================
// 1. 하드웨어 주소 및 디바이스 ID 매크로 정의
// ==============================================================================
#define IIC_BASE_ADDR       XPAR_IIC_0_BASEADDR
#define GPIO_7SEG_ID        XPAR_AXI_GPIO_0_DEVICE_ID
#define GPIO_LED_BTN_ID     XPAR_AXI_GPIO_1_DEVICE_ID

// LSM9DS1 가속도/자이로 센서 I2C 주소
#define LSM9DS1_AG_ADDR_1   0x6B
#define LSM9DS1_AG_ADDR_2   0x6A

// LSM9DS1 주요 레지스터 주소
#define REG_WHO_AM_I_XG     0x0F
#define REG_CTRL_REG6_XL    0x20
#define REG_OUT_X_L_XL      0x28

// ==============================================================================
// 2. 전역 변수 (GPIO 인스턴스)
// ==============================================================================
XGpio Gpio_7Seg;
XGpio Gpio_LedBtn;

// ==============================================================================
// 3. I2C 통신 편의를 위한 사용자 정의 함수
// ==============================================================================
int I2C_WriteReg(u8 SlaveAddr, u8 RegAddr, u8 Data) {
    u8 write_buf[2];
    write_buf[0] = RegAddr;
    write_buf[1] = Data;
    return XIic_Send(IIC_BASE_ADDR, SlaveAddr, write_buf, 2, XIIC_STOP);
}

int I2C_ReadReg(u8 SlaveAddr, u8 RegAddr, u8 *DataBuffer, unsigned ByteCount) {
    XIic_Send(IIC_BASE_ADDR, SlaveAddr, &RegAddr, 1, XIIC_REPEATED_START);
    return XIic_Recv(IIC_BASE_ADDR, SlaveAddr, DataBuffer, ByteCount, XIIC_STOP);
}

// ==============================================================================
// 4. 메인 함수 (디바이스 추적 및 복합 시스템 제어)
// ==============================================================================
int main()
{
    int Status;
    u8 Target_Addr = LSM9DS1_AG_ADDR_1;
    u8 who_am_i = 0;
    u8 rx_data[6];

    // Tera Term 창이 정상적으로 열릴 수 있도록 초기 2초 대기
    sleep(2);

    xil_printf("\n\r======================================\n\r");
    xil_printf("  DEBUG MODE: System Initialization...\n\r");
    xil_printf("======================================\n\r");

    // ---------------------------------------------------------
    // [단계 A] GPIO 초기화 확인 영역
    // ---------------------------------------------------------
    xil_printf("[DEBUG 1] Initializing 7-Segment GPIO...\n\r");
    Status = XGpio_Initialize(&Gpio_7Seg, GPIO_7SEG_ID);
    if (Status != XST_SUCCESS) {
        xil_printf("[ERROR] 7-Segment GPIO Initialization Failed!\n\r");
        return XST_FAILURE;
    }
    XGpio_SetDataDirection(&Gpio_7Seg, 1, 0x00000000);
    xil_printf("[DEBUG 1] 7-Segment GPIO Success!\n\r");

    xil_printf("[DEBUG 2] Initializing LED/BTN GPIO...\n\r");
    Status = XGpio_Initialize(&Gpio_LedBtn, GPIO_LED_BTN_ID);
    if (Status != XST_SUCCESS) {
        xil_printf("[ERROR] LED/BTN GPIO Initialization Failed!\n\r");
        return XST_FAILURE;
    }
    XGpio_SetDataDirection(&Gpio_LedBtn, 1, 0x00000000); // LED (Output)
    XGpio_SetDataDirection(&Gpio_LedBtn, 2, 0xFFFFFFFF); // BTN (Input)
    xil_printf("[DEBUG 2] LED/BTN GPIO Success!\n\r");

    // ---------------------------------------------------------
    // [단계 B] I2C 하드웨어 리셋 영역
    // ---------------------------------------------------------
    xil_printf("[DEBUG 3] Resetting AXI IIC Controller Registers...\n\r");
    XIic_WriteReg(IIC_BASE_ADDR, XIIC_CR_REG_OFFSET, 0x00);
    XIic_WriteReg(IIC_BASE_ADDR, XIIC_CR_REG_OFFSET, XIIC_CR_TX_FIFO_RESET_MASK);
    XIic_WriteReg(IIC_BASE_ADDR, XIIC_CR_REG_OFFSET, XIIC_CR_ENABLE_DEVICE_MASK);
    usleep(50000); // 50ms 대기
    xil_printf("[DEBUG 3] AXI IIC Controller Reset Complete!\n\r");

    // ---------------------------------------------------------
    // [단계 C] 센서 탐색 영역
    // ---------------------------------------------------------
    xil_printf("[DEBUG 4] Attempting to read WHO_AM_I from Sensor (Addr: 0x6B)...\n\r");
    I2C_ReadReg(Target_Addr, REG_WHO_AM_I_XG, &who_am_i, 1);

    if (who_am_i != 0x68) {
        xil_printf("[DEBUG 5] Failed at 0x6B. Retrying with Addr 0x6A...\n\r");
        Target_Addr = LSM9DS1_AG_ADDR_2;
        I2C_ReadReg(Target_Addr, REG_WHO_AM_I_XG, &who_am_i, 1);
    }

    if (who_am_i == 0x68) {
        xil_printf("[DEBUG 6] LSM9DS1 Sensor Successfully Found! (Address: 0x%02X)\n\r", Target_Addr);
    } else {
        xil_printf("[CRITICAL ERROR] Sensor Not Found! Read Value: 0x%02X (Expected: 0x68)\n\r", who_am_i);
        return XST_FAILURE;
    }

    // ---------------------------------------------------------
    // [단계 D] 센서 제어 설정 활성화
    // ---------------------------------------------------------
    xil_printf("[DEBUG 7] Activating Accelerometer Sensor (CTRL_REG6_XL)...\n\r");
    I2C_WriteReg(Target_Addr, REG_CTRL_REG6_XL, 0x60);
    usleep(100000);
    xil_printf("[DEBUG 7] Sensor Activation Done!\n\r");

    // ---------------------------------------------------------
    // [단계 E] 메인 데이터 수집 루프 진입 (세부 기능 커스텀 변경)
    // ---------------------------------------------------------
    xil_printf("[DEBUG 8] Entering Main Infinite Loop. System Operational.\n\r");

    int display_mode = 0;        // 0: X축, 1: Y축, 2: Z축 (버튼 0으로 제어)
    short offset_x = 0, offset_y = 0, offset_z = 0; // 영점 저장용 변수 (버튼 1, 2로 제어)
    int is_paused = 0;           // 화면 정지 플래그 (버튼 3으로 제어)
    u32 prev_btn = 0;            // 엣지 검출을 위한 이전 버튼 값 저장 변수

    while (1) {
        // 1. 센서 데이터 6바이트 연속 읽기
        I2C_ReadReg(Target_Addr, REG_OUT_X_L_XL, rx_data, 6);

        // 2. 비트 결합 (Raw 데이터)
        short accel_x = (short)((rx_data[1] << 8) | rx_data[0]);
        short accel_y = (short)((rx_data[3] << 8) | rx_data[2]);
        short accel_z = (short)((rx_data[5] << 8) | rx_data[4]);

        // 3. 버튼 입력 처리 (누르는 순간만 반응하는 엣지 검출 방식)
        u32 btn_state = XGpio_DiscreteRead(&Gpio_LedBtn, 2);
        u32 btn_press = btn_state & ~prev_btn; // 스위치를 누르는 순간(0->1)만 1이 됨
        prev_btn = btn_state;

        // [버튼 0] 누를 때마다 XYZ 모드 순환 변경
        if (btn_press & 0x01) {
            display_mode = (display_mode + 1) % 3;
            xil_printf("\n\r>>> Mode Changed to: %u (0:X, 1:Y, 2:Z) <<<\n\r", display_mode);
        }
        // [버튼 1] 기준 자세 저장 (Calibration)
        if (btn_press & 0x02) {
            offset_x = accel_x;
            offset_y = accel_y;
            offset_z = accel_z;
            xil_printf("\n\r>>> Current Attitude Saved as Reference (Calibration)! <<<\n\r");
        }
        // [버튼 2] 표시 초기화 (Reset)
        if (btn_press & 0x04) {
            offset_x = 0;
            offset_y = 0;
            offset_z = 0;
            xil_printf("\n\r>>> Calibration Values Cleared (Reset)! <<<\n\r");
        }
        // [버튼 3] 화면 일시 정지 Toggle
        if (btn_press & 0x08) {
            is_paused = !is_paused;
            xil_printf("\n\r>>> Display Pause State: %d <<<\n\r", is_paused);
        }

        // 일시 정지(Pause) 상태가 아닐 때만 디스플레이와 LED를 새로고침
        if (!is_paused) {
            // 캘리브레이션이 적용된 최종 보정 데이터 연산
            short calib_x = accel_x - offset_x;
            short calib_y = accel_y - offset_y;
            short calib_z = accel_z - offset_z;

            // 4. 7-Segment 출력 로직 (현재 모드에 맞는 축 선택)
            short target_val = 0;
            if (display_mode == 0)      target_val = calib_x;
            else if (display_mode == 1) target_val = calib_y;
            else                        target_val = calib_z;

            // 크기 비교를 위해 절댓값으로 변환
            int abs_val = target_val;
            if (abs_val < 0) abs_val = -abs_val;

            XGpio_DiscreteWrite(&Gpio_7Seg, 1, (u32)abs_val);

            // 5. LED 및 RGB LED 종합 출력 제어
            u32 led_out = 0x0000;
            int threshold = 8000;

            // (1) 일반 LED (0~9번): 축 데이터 크기에 비례하는 레벨 미터 바 그래프
            int level = abs_val / 1500; // 1500 크기당 LED 한 칸씩 점등
            if (level > 10) level = 10;
            u32 bar_graph = (1 << level) - 1;
            led_out |= (bar_graph & 0x03FF); // 하위 10비트에 매핑

            // (2) RGB LED 1 (10, 11, 12번): 현재 디스플레이 모드 색상 표시
            if (display_mode == 0)      led_out |= (1 << 10); // X축 모드 = Red
            else if (display_mode == 1) led_out |= (1 << 11); // Y축 모드 = Green
            else                        led_out |= (1 << 12); // Z축 모드 = Blue

            // (3) RGB LED 2 (13, 14, 15번): 위험 기울기 상태 알람등
            if (abs_val > threshold) {
                led_out |= (1 << 13); // 임계값(8000) 초과 시 경고 (Red)
            } else {
                led_out |= (1 << 14); // 안전 범위 이내 평시 상태 (Green)
            }

            XGpio_DiscreteWrite(&Gpio_LedBtn, 1, led_out);

            // 6. UART 터미널 출력 (보정된 축 데이터 모니터링)
            xil_printf("Mode: %d | Calib_X: %6d, Y: %6d, Z: %6d\r", display_mode, calib_x, calib_y, calib_z);
        }

        usleep(100000);
    }

    return 0;
}
