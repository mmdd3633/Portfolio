#include "xparameters.h"  // 하드웨어 설정(Vivado)에서 생성된 ID 값들이 정의된 핵심 헤더 파일
#include "xgpio.h"        // Xilinx PL AXI GPIO 제어를 위한 전용 함수 라이브러리
#include "xil_printf.h"   // UART 터미널 출력을 위한 라이브러리

/* * Vivado에서 AXI GPIO IP를 추가할 때 부여된 디바이스 ID입니다.
 * xparameters.h 파일 안에 정의되어 있으며, 하드웨어 설정 이름에 따라
 * XPAR_GPIO_0_DEVICE_ID 등으로 다를 수 있으므로 에러 발생 시 확인이 필요합니다.
 */
#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define LED_CHANNEL     1  // 제어할 GPIO IP의 채널 (기본값 1채널 사용)

XGpio Gpio; // GPIO 하드웨어 장치를 제어하기 위한 구조체 인스턴스 선언

int main()
{
    int Status;

    /*
     * 요구사항 1: 프로그램 시작 시 지정된 문구 출력
     * 터미널에서 올바르게 줄바꿈이 되도록 \n(Line Feed)과 \r(Carriage Return)을 함께 사용합니다.
     */
    xil_printf("PL GPIO TEST PROGRAM\n\r");

    /*
     * GPIO 초기화 단계
     * 설정한 DEVICE_ID를 바탕으로 Gpio 하드웨어 모듈을 활성화합니다.
     */
    Status = XGpio_Initialize(&Gpio, GPIO_DEVICE_ID);
    if (Status != XST_SUCCESS) {
        // 초기화 실패 시 터미널에 에러를 출력하고 프로그램을 종료합니다.
        xil_printf("GPIO Initialization Failed!\n\r");
        return XST_FAILURE;
    }

    /*
     * GPIO 입출력 방향 설정
     * 두 번째 인자: 제어할 채널 (LED_CHANNEL = 1)
     * 세 번째 인자: 방향 비트 마스크.
     * 0x00000000으로 설정하면 AXI GPIO에 연결된 모든 핀이 '출력(Output)' 모드가 됩니다.
     */
    XGpio_SetDataDirection(&Gpio, LED_CHANNEL, 0x00000000);

    /*
     * 요구사항 2: 10개의 LED 모두 켜기 (핵심)
     * XGpio_DiscreteWrite 함수는 지정된 채널에 특정 값을 한 번에 출력합니다.
     * * [왜 0x3FF를 입력하나요?]
     * 10개의 LED를 모두 켜려면 0번 핀부터 9번 핀까지 총 10개의 비트에 모두 1(High) 신호를 주어야 합니다.
     * 이를 2진수로 표현하면 '11 1111 1111'이 됩니다.
     * 2진수 '11 1111 1111'을 16진수로 변환하면 '0x3FF'가 됩니다. (10진수로는 1023입니다.)
     * 따라서 0x3FF를 출력 값으로 전달하면 연결된 10개의 LED가 동시에 점등됩니다.
     */
    XGpio_DiscreteWrite(&Gpio, LED_CHANNEL, 0x3FF);

    xil_printf("10 LEDs are successfully turned ON.\n\r");

    /* 프로그램이 종료되더라도 LED에 인가된 전압은 하드웨어적으로 유지되어 계속 켜져 있습니다. */
    return 0;
}
