#include <stdio.h>
#include <stdlib.h>    // atoi 함수 사용
#include "xparameters.h"
#include "xgpio.h"
#include "xil_printf.h"

// 하드웨어 설정값 (Vivado Address Editor 확인)
#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define RGB_CH 1

XGpio Gpio;

int main() {
    int status;
    char input_buf[32]; // 입력 문자열 저장 버퍼
    int r_val = 0;
    u32 combined_rgb_data;

    // 1. AXI GPIO 초기화
    status = XGpio_Initialize(&Gpio, GPIO_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("GPIO Initialization Failed!\r\n");
        return XST_FAILURE;
    }

    // 2. GPIO 방향 설정 (출력: 0)
    XGpio_SetDataDirection(&Gpio, RGB_CH, 0x0);

    xil_printf("\r\n******************************************\r\n");
    xil_printf("   Blackboard LD10 Red LED Control System  \r\n");
    xil_printf("   Enter Intensity (0-255) and Press Enter \r\n");
    xil_printf("******************************************\r\n");

    while(1) {
        xil_printf("\r\n[INPUT] Red Value: ");

        // 3. scanf 대신 fgets를 사용하여 한 줄 통째로 입력 대기
        if (fgets(input_buf, sizeof(input_buf), stdin) != NULL) {

            // 4. 문자열을 정수로 변환 (문자열 버퍼 문제 해결)
            r_val = atoi(input_buf);

            // 5. 범위 제한 (Saturation)
            if(r_val > 255) r_val = 255;
            if(r_val < 0) r_val = 0;

            // 6. 하드웨어 비트 위치 정렬 (Red는 [23:16] 비트 할당 가정)
            combined_rgb_data = ((u32)r_val << 16);

            // 7. AXI GPIO 레지스터 쓰기
            XGpio_DiscreteWrite(&Gpio, RGB_CH, combined_rgb_data);

            xil_printf(">> Successfully Applied: %d (Data: 0x%08X)\r\n", r_val, combined_rgb_data);
        }
    }

    return 0;
}
