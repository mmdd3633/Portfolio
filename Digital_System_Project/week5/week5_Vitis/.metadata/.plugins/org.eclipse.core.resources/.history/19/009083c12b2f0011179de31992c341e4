#include <stdio.h>
#include <stdlib.h>
#include "xparameters.h"
#include "xgpio.h"
#include "xil_printf.h"

// Vivado Block Design에서 확인한 AXI_GPIO_0의 Device ID
#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define RGB_CH 1  // 채널 1 사용

XGpio Gpio;

int main() {
    int status;
    int r_val = 0, g_val = 0, b_val = 0;
    u32 combined_rgb;

    // 1. AXI GPIO 초기화
    status = XGpio_Initialize(&Gpio, GPIO_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("GPIO 초기화 실패!\r\n");
        return XST_FAILURE;
    }

    // 2. GPIO 방향 설정 (24비트 모두 출력: 0)
    XGpio_SetDataDirection(&Gpio, RGB_CH, 0x000000);

    xil_printf("\r\n==========================================\r\n");
    xil_printf("   Blackboard RGB LED (LD10) Control    \r\n");
    xil_printf("   Enter values between 0 and 255       \r\n");
    xil_printf("==========================================\r\n");

    while(1) {
        // Tera Term 입력 안내
        xil_printf("\r\nInput Red Intensity (0-255): ");
        scanf("%d", &r_val);
        
        xil_printf("Input Green Intensity (0-255): ");
        scanf("%d", &g_val);
        
        xil_printf("Input Blue Intensity (0-255): ");
        scanf("%d", &b_val);

        // 입력값 범위 제한 (Saturation)
        if(r_val > 255) r_val = 255; else if(r_val < 0) r_val = 0;
        if(g_val > 255) g_val = 255; else if(g_val < 0) g_val = 0;
        if(b_val > 255) b_val = 255; else if(b_val < 0) b_val = 0;

        // 3. 24비트 데이터 패킹 (R: [23:16], G: [15:8], B: [7:0])
        combined_rgb = ((u32)r_val << 16) | ((u32)g_val << 8) | (u32)b_val;

        // 4. AXI GPIO를 통해 PL의 PWM 모듈로 데이터 전송
        XGpio_DiscreteWrite(&Gpio, RGB_CH, combined_rgb);

        xil_printf("\r\n[결과] R:%d, G:%d, B:%d 적용 완료 (Data: 0x%06X)\r\n", 
                    r_val, g_val, b_val, combined_rgb);
    }

    return 0;
}