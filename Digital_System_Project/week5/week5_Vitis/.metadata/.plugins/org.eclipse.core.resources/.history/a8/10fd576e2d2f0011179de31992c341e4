#include <stdio.h>
#include "xparameters.h"
#include "xgpio.h"
#include "xil_printf.h"

#define GPIO_DEVICE_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#define RGB_CH 1

XGpio Gpio;

int main() {
    int status;
    int r_val = 0;
    u32 combined_rgb;

    status = XGpio_Initialize(&Gpio, GPIO_DEVICE_ID);
    if (status != XST_SUCCESS) return XST_FAILURE;

    XGpio_SetDataDirection(&Gpio, RGB_CH, 0x0);

    xil_printf("--- LD10 Red LED Control Started ---\n\r");

    while(1) {
        xil_printf("\n\rInput Red Brightness (0-255): ");

        // 숫자 하나만 입력받음
        if (scanf("%d", &r_val) != 1) {
            // 숫자가 아닌게 들어오면 버퍼 비우고 다시 대기
            getchar();
            continue;
        }

        // 범위 제한
        if(r_val > 255) r_val = 255;
        if(r_val < 0) r_val = 0;

        // 하드웨어 설계가 R: [23:16] 비트라면 아래처럼 Shift 해줌
        // 만약 하드웨어가 8비트 하나만 받는 구조면 그냥 r_val만 써도 됨
        combined_rgb = ((u32)r_val << 16);

        XGpio_DiscreteWrite(&Gpio, RGB_CH, combined_rgb);

        xil_printf("Red Value Applied: %d\n\r", r_val);

        // 입력 후 남아있는 엔터(\n) 제거해서 무한루프 방지
        getchar();
    }
    return 0;
}
