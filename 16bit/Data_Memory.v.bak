module data_memory (
    input wire clk,
    input wire mem_rd,
    input wire mem_wr,
    input wire [11:0] mem_addr,
    input wire [15:0] mem_data,
    output reg [15:0] mem_dataout
);

    reg [15:0] mem [0:4095];  // 4096 x 16bit RAM

    // ?? ??
    always @(posedge clk) begin
        if (mem_wr)
            mem[mem_addr] <= mem_data;
    end

    // ?? ??
    always @(*) begin
        if (mem_rd)
            mem_dataout = mem[mem_addr];
        else
            mem_dataout = 16'h0001;
    end

endmodule