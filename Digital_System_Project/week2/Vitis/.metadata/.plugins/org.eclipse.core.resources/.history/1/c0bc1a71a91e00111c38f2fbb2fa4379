/******************************************************************************
 * Zynq PS MIO GPIO 제어 실습 코드
 * 대상 칩: Zynq-7000S (xc7z007s)
 * 제어 대상: PS MIO 16번 핀 (RGB Blue LED)
 * 설명: MIO 16번 핀을 출력으로 설정하고 High(1) 신호를 주어 파란색 LED를 켭니다.
 ******************************************************************************/

#include "xparameters.h"  // 하드웨어 파라미터 정보 (Device ID 등)
#include "xgpiops.h"      // Zynq PS GPIO 제어를 위한 전용 API 헤더 (가장 중요)
#include "xil_printf.h"   // 시리얼 터미널 출력용 헤더

// xparameters.h에 정의된 PS GPIO의 Device ID
#define GPIO_DEVICE_ID      XPAR_XGPIOPS_0_DEVICE_ID

// 제어하고자 하는 정확한 MIO 핀 번호 지정
#define MIO_LED_BLUE_PIN    17

// PS GPIO 하드웨어를 제어하기 위한 인스턴스(객체) 구조체 선언
XGpioPs Gpio_Inst;

int main(void) {
    int Status;
    XGpioPs_Config *ConfigPtr; // 초기화 설정을 담을 포인터

    xil_printf("--- PS MIO 16번(Blue LED) 제어 프로그램을 시작합니다 ---\r\n");

    /* * 1단계: PS GPIO 하드웨어 설정 검색 (Lookup Config)
     * Device ID를 기반으로 시스템에 매핑된 PS GPIO의 기본 설정값을 찾아옵니다.
     */
    ConfigPtr = XGpioPs_LookupConfig(GPIO_DEVICE_ID);
    if (ConfigPtr == NULL) {
        xil_printf("오류: PS GPIO 설정 정보를 찾을 수 없습니다!\r\n");
        return XST_FAILURE;
    }

    /* * 2단계: PS GPIO 초기화 (Initialize)
     * 찾아온 설정값을 바탕으로 실제 Gpio_Inst 구조체를 초기화하여 활성화합니다.
     */
    Status = XGpioPs_CfgInitialize(&Gpio_Inst, ConfigPtr, ConfigPtr->BaseAddr);
    if (Status != XST_SUCCESS) {
        xil_printf("오류: PS GPIO 초기화에 실패했습니다!\r\n");
        return XST_FAILURE;
    }
    xil_printf("PS GPIO 초기화 성공.\r\n");

    /* * 3단계: 핀 입출력 방향(Direction) 설정
     * 인자: (인스턴스 주소, 핀 번호, 방향)
     * 방향 값으로 1을 주면 출력(Output), 0을 주면 입력(Input)이 됩니다.
     * MIO 16번 핀을 출력(1)으로 설정합니다.
     */
    XGpioPs_SetDirectionPin(&Gpio_Inst, MIO_LED_BLUE_PIN, 1);

    /* * 4단계: 핀 출력 활성화 (Output Enable)
     * 인자: (인스턴스 주소, 핀 번호, 활성화 여부)
     * 방향을 출력으로 잡았더라도, 실제로 신호가 나가도록 Output Enable을 1(활성화)로 켜주어야 합니다.
     */
    XGpioPs_SetOutputEnablePin(&Gpio_Inst, MIO_LED_BLUE_PIN, 1);
    xil_printf("MIO 16번 핀 출력 설정 완료.\r\n");

    /* * 5단계: 핀에 High 신호 출력 (Write)
     * 인자: (인스턴스 주소, 핀 번호, 데이터 값)
     * 데이터 값으로 1(High)을 주어 파란색 LED를 점등시킵니다.
     * 만약 끄고 싶다면 0(Low)을 주면 됩니다.
     */
    xil_printf("MIO 16번 핀에 High(1) 신호를 출력하여 Blue LED를 켭니다.\r\n");
    XGpioPs_WritePin(&Gpio_Inst, MIO_LED_BLUE_PIN, 1);

    xil_printf("프로그램 동작 완료.\r\n");

    // 프로그램이 바로 종료되지 않도록 무한 대기 (운영체제가 없는 Bare-metal 환경의 권장 사항)
    while (1) {
    }

    return XST_SUCCESS;
}
